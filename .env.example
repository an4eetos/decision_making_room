# Decision Room — copy to .env and edit. Real environment variables win over
# anything set here.

DATABASE_URL=postgres://room:room@localhost:5432/decision_room?sslmode=disable
HTTP_ADDR=:8080

# LLM provider: "gemini" (cloud, no Docker Ollama needed) or "ollama" (fully local)
LLM_PROVIDER=gemini

# Gemini — free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# An alias, deliberately: pinned versions get retired and the app then fails on
# every question with "this model is no longer available".
GEMINI_CHAT_MODEL=gemini-flash-latest
# Tried when the chat model is overloaded or out of quota. Free-tier quota is
# counted per model, so this is the difference between a failed question and a
# slightly weaker answer. Set empty to disable.
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest
# Or set the whole chain explicitly, tried left to right.
# GEMINI_CHAT_MODELS=gemini-flash-latest,gemini-2.5-flash,gemini-flash-lite-latest
GEMINI_EMBED_MODEL=gemini-embedding-001

# Ollama (when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3:8b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Your journal. about-me.md and everything under context/ is injected into every
# answer; everything else is retrieved on demand.
JOURNAL_WATCH_DIR=./journal
JOURNAL_WATCH_ENABLED=true
ABOUT_ME_FILE=./journal/about-me.md
CONTEXT_DIR=./journal/context
INITIAL_CONTEXT_MAX_RUNES=0

# Retrieval
RETRIEVAL_TOP_K=8
RETRIEVAL_CANDIDATES=30

# Leave WEB_ROOT empty to serve the frontend embedded in the binary. Point it at
# ./internal/web/assets to edit templates and CSS without rebuilding.
WEB_ROOT=

# Answer depth. DEFAULT_TIER is used when a request does not pick one; MAX_TIER
# is the ceiling a request cannot exceed. Set MAX_TIER=quick to disable tool
# calling entirely (this replaces the old AGENTIC_RAG_ENABLED flag).
DEFAULT_TIER=standard
MAX_TIER=deep

# Optional overlay for the relocation knowledge base. Point at a directory with
# catalog/ and pitfalls/ subdirectories of YAML; an entry with an existing id
# replaces the shipped one, a new id is appended.
RELOCATION_CATALOG_DIR=

# Optional overlay for the generals roster. Point at a directory with generals/
# and styles/ subdirectories of markdown; a file whose id matches a shipped one
# replaces it, a new id is appended.
GENERALS_DIR=

# Optional overlay for conversation modes. A file whose id matches a shipped mode
# replaces it, a new id is appended.
MODES_DIR=
